@@ -1472,6 +1503,11 @@ public class ServerLevel extends Level implements WorldGenLevel, ServerEntityGet
     }
 
     private void tickBlock(final BlockPos pos, final Block type) {
+        // Canvas - region may have been reconfigured after this tick was scheduled;
+        // reschedule onto the region that currently owns the block instead of crashing.
+        if (!ca.spottedleaf.moonrise.common.util.TickThread.isTickThreadFor(this, pos)) {
+            return; // drop stale tick; region will tick the block on its own
+        }
         BlockState state = this.getBlockState(pos);
         if (state.is(type)) {
             state.tick(this, pos, this.random);
@@ -1527,6 +1563,28 @@ public class ServerLevel extends Level implements WorldGenLevel, ServerEntityGet
         // Paper end - log detailed entity tick information
     }
 
+    /**
+     * Canvas - full tick for shard-owned non-player entities. Portal handling,
+     * post-tick portal checks, and passenger recursion deliberately remain on
+     * the parent region thread.
+     */
+    public void tickShardedNonPassenger(final Entity entity) {
+        ca.spottedleaf.moonrise.common.util.TickThread.ensureTickThread("Cannot tick an entity off-main");
+        if (entity instanceof Player) {
+            throw new IllegalStateException("Players must use tickNonPassenger");
+        }
+        entity.commonTick();
+        final boolean isActive = io.papermc.paper.entity.activation.ActivationRange.checkIfActive(entity);
+        if (isActive) {
+            entity.tick();
+            if (!ca.spottedleaf.moonrise.common.util.TickThread.isTickThreadFor(entity)) {
+                return;
+            }
+        } else {
+            entity.inactiveTick();
+        }
+    }
+
     private void tickPassenger(final Entity vehicle, final Entity entity, final boolean isActive) { // Paper - EAR 2
         if (entity.isRemoved() || entity.getVehicle() != vehicle) {
             entity.stopRiding();
@@ -1779,6 +1837,7 @@ public class ServerLevel extends Level implements WorldGenLevel, ServerEntityGet
 
     // CraftBukkit start
     private boolean addEntity(final Entity entity, final org.bukkit.event.entity.CreatureSpawnEvent.@Nullable SpawnReason spawnReason) {
+        io.canvasmc.canvas.threadedregions.sharding.RegionShardExecutor.rejectShardWorkerEntityAdd(entity);
         org.spigotmc.AsyncCatcher.catchOp("entity add"); // Spigot
         entity.generation = false; // Paper - Don't fire sync event during generation; Reset flag if it was added during a ServerLevel generation process
