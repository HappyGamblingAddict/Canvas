+    /**
+     * Canvas - captures POI point metadata without loading POI chunks. Only
+     * sections whose POI chunk is already loaded are marked as covered; a
+     * missing section is therefore unknown rather than absent.
+     */
+    public void canvas$captureLoadedPois(
+        final Iterable<net.minecraft.world.level.chunk.LevelChunk> chunks,
+        final java.util.Map<BlockPos, io.canvasmc.canvas.threadedregions.sharding.RegionShardSnapshot.PoiEntry> entries,
+        final it.unimi.dsi.fastutil.longs.LongSet sections
+    ) {
+        io.canvasmc.canvas.threadedregions.sharding.RegionShardExecutor.ensureSerialPoiAccess("PoiManager POI snapshot capture");
+        final ca.spottedleaf.moonrise.patches.chunk_system.scheduling.ChunkHolderManager manager =
+            ((ca.spottedleaf.moonrise.patches.chunk_system.level.ChunkSystemServerLevel)this.world)
+                .moonrise$getChunkTaskScheduler().chunkHolderManager;
+        for (final net.minecraft.world.level.chunk.LevelChunk chunk : chunks) {
+            final int chunkX = chunk.getPos().x();
+            final int chunkZ = chunk.getPos().z();
+            final ca.spottedleaf.moonrise.patches.chunk_system.level.poi.PoiChunk poiChunk =
+                manager.getPoiChunkIfLoaded(chunkX, chunkZ, true);
+            if (poiChunk == null) continue;
+            for (int sectionY = ca.spottedleaf.moonrise.common.util.WorldUtil.getMinSection(this.world);
+                 sectionY <= ca.spottedleaf.moonrise.common.util.WorldUtil.getMaxSection(this.world); sectionY++) {
+                sections.add(SectionPos.asLong(chunkX, sectionY, chunkZ));
+                final PoiSection section = poiChunk.getSection(sectionY);
+                if (section == null) continue;
+                for (final java.util.Set<PoiRecord> records : section.byType.values()) {
+                    for (final PoiRecord record : records) {
+                        final BlockPos pos = record.getPos();
+                        entries.put(pos, new io.canvasmc.canvas.threadedregions.sharding.RegionShardSnapshot.PoiEntry(pos, record.getPoiType()));
+                    }
+                }
+            }
+        }
+    }
+
     public @Nullable PoiRecord add(final BlockPos pos, final Holder<PoiType> type) {
+        io.canvasmc.canvas.threadedregions.sharding.RegionShardExecutor.ensureSerialPoiAccess("PoiManager.add");
         return this.getOrCreate(SectionPos.asLong(pos)).add(pos, type);
     }
 
     public void remove(final BlockPos pos) {
+        io.canvasmc.canvas.threadedregions.sharding.RegionShardExecutor.ensureSerialPoiAccess("PoiManager.remove");
         this.getOrLoad(SectionPos.asLong(pos)).ifPresent(poiSection -> poiSection.remove(pos));
     }
 
