--- a/io/papermc/paper/threadedregions/TickRegions.java
+++ b/io/papermc/paper/threadedregions/TickRegions.java
@@ -225,21 +225,111 @@ public final class TickRegions implements ThreadedRegionizer.RegionCallbacks<Tic
         if (data == null) return;
         if (region.regioniser.world.canvas$unloadTicket.isPresent()) return;
 
         final io.papermc.paper.configuration.GlobalConfiguration.ThreadedRegions cfg =
             io.papermc.paper.configuration.GlobalConfiguration.get().threadedRegions;
-        final boolean busy =
-            (cfg.maxPlayersPerRegion > 0 && data.getRegionStats().getPlayerCount() > cfg.maxPlayersPerRegion)
-            || (cfg.maxEntitiesPerRegion > 0 && data.getRegionStats().getEntityCount() > cfg.maxEntitiesPerRegion);
+        final io.canvasmc.canvas.GlobalConfiguration.RegionScheduler.AutoSplit auto =
+            io.canvasmc.canvas.GlobalConfiguration.getInstance().regionScheduler.autoSplit;
+        final int players = data.getRegionStats().getPlayerCount();
+        final int entities = data.getRegionStats().getEntityCount();
+        final double mspt = data.getMSPT(RegionTickData.Frame._15_SECONDS);
         final boolean forced = data.canvas$splitRequested.getAndSet(false);
-        if ((!busy && !forced) || (!cfg.enableLiveSplit && !forced)) return;
+
+        final boolean playerOver = cfg.maxPlayersPerRegion > 0 && players > cfg.maxPlayersPerRegion;
+        final boolean entityOver = cfg.maxEntitiesPerRegion > 0 && entities > cfg.maxEntitiesPerRegion;
+        final boolean tickOver = auto.enabled && auto.maxMspt > 0.0D && mspt >= auto.maxMspt;
+        final boolean autoBusy = tickOver
+            && (players >= auto.minPlayers || entities >= auto.minEntities || playerOver || entityOver);
+        final boolean busy = playerOver || entityOver || autoBusy;
+
+        if (!forced && (region.regioniser.getSectionCount(region) < 2 || (players == 0 && entities == 0))) {
+            data.canvas$autoSplitTicks = 0;
+            return;
+        }
+
+        // Player-region live splitting still has a transfer race in this preview
+        // (the player's pending teleport can be accepted by the wrong region).
+        // Keep it opt-in until that path is fixed; entity-only regions are safe.
+        if (!forced && players > 0 && !auto.allowPlayerRegions) {
+            data.canvas$autoSplitTicks = 0;
+            data.canvas$lastSplitResult = "player region; automatic split disabled";
+            final long now = System.currentTimeMillis();
+            if (now - data.canvas$lastAutoSplitLog >= 60_000L) {
+                data.canvas$lastAutoSplitLog = now;
+                LOGGER.warn("Canvas auto-split skipped region {}: {} players and {:.1f}ms; "
+                        + "player-region splitting is disabled until its transfer race is fixed",
+                    region.getId(), players, mspt);
+            }
+            return;
+        }
+
+        if ((!busy && !forced) || (!cfg.enableLiveSplit && !forced)) {
+            data.canvas$autoSplitTicks = 0;
+            return;
+        }
+
+        final List<ServerPlayer> localPlayers = TickRegionScheduler.getCurrentRegionizedWorldData().getLocalPlayers();
+        final int shift = region.regioniser.sectionChunkShift;
+
+        if (!forced) {
+            if (!autoBusy) {
+                data.canvas$autoSplitTicks = 0;
+                return;
+            }
+            if (++data.canvas$autoSplitTicks < auto.sustainTicks) {
+                return;
+            }
+
+            // A single hot section cannot be divided by region splitting. Detect
+            // it and leave the decision to a lobby instance/queue instead of
+            // moving chunk ownership for no gain.
+            final java.util.Map<Long, Integer> perSection = new java.util.HashMap<>();
+            int hotspot = 0;
+            for (final ServerPlayer player : localPlayers) {
+                final long key = ca.spottedleaf.moonrise.common.util.CoordinateUtils.getChunkKey(
+                    player.chunkPosition().x() >> shift,
+                    player.chunkPosition().z() >> shift
+                );
+                hotspot = Math.max(hotspot, perSection.merge(key, 1, Integer::sum));
+            }
+            if (localPlayers.size() >= auto.minPlayers
+                && hotspot >= (int) Math.ceil(localPlayers.size() * auto.hotspotShare)) {
+                data.canvas$autoSplitTicks = 0;
+                data.canvas$lastSplitResult = "hotspot " + hotspot + "/" + localPlayers.size()
+                    + " players in one section";
+                final long now = System.currentTimeMillis();
+                if (now - data.canvas$lastAutoSplitLog >= 30_000L) {
+                    data.canvas$lastAutoSplitLog = now;
+                    LOGGER.warn("Canvas auto-split skipped region {}: hotspot section holds {}/{} players; "
+                            + "region splitting cannot divide one section, use another lobby instance or queue",
+                        region.getId(), hotspot, localPlayers.size());
+                }
+                return;
+            }
+
+            if (auto.maxRegions > 0) {
+                final AtomicInteger sectionRegions = new AtomicInteger();
+                region.regioniser.computeForAllRegions(candidate -> {
+                    if (!candidate.isDead() && candidate.regioniser.getSectionCount(candidate) > 0) {
+                        sectionRegions.incrementAndGet();
+                    }
+                });
+                if (sectionRegions.get() >= auto.maxRegions) {
+                    data.canvas$autoSplitTicks = 0;
+                    data.canvas$lastSplitResult = "max regions reached (" + sectionRegions.get() + ")";
+                    return;
+                }
+            }
+        }
 
         final long now = System.currentTimeMillis();
         // More shards create more boundaries at once, so give them a longer
         // global settling period than the conservative two-way default.
         final long globalCooldown = 15000L * Math.max(1L, cfg.liveSplitShards / 2);
-        if (now - data.canvas$lastLiveSplit <= 10000L
+        final long autoCooldown = Math.max(10_000L, auto.cooldownSeconds * 1000L);
+        final long cooldown = forced ? globalCooldown : Math.max(globalCooldown, autoCooldown);
+        if (now - data.canvas$lastLiveSplit <= cooldown
             || now - CANVAS_LAST_GLOBAL_SPLIT.get() <= globalCooldown) {
             // Keep a manual request queued until the safety cooldown expires.
             if (forced) data.canvas$splitRequested.set(true);
             return;
         }
@@ -247,18 +337,36 @@ public final class TickRegions implements ThreadedRegionizer.RegionCallbacks<Tic
                 CANVAS_LAST_GLOBAL_SPLIT.get(), now)) {
             if (forced) data.canvas$splitRequested.set(true);
             return;
         }
         data.canvas$lastLiveSplit = now;
-        final boolean split = region.regioniser.splitRegionLive(region);
+        data.canvas$autoSplitTicks = 0;
+
+        final java.util.Set<Long> playerSections = new java.util.HashSet<>();
+        for (final ServerPlayer player : localPlayers) {
+            playerSections.add(ca.spottedleaf.moonrise.common.util.CoordinateUtils.getChunkKey(
+                player.chunkPosition().x() >> shift,
+                player.chunkPosition().z() >> shift
+            ));
+        }
+        final boolean split = region.regioniser.splitRegionLive(
+            region, cfg.liveSplitShards, playerSections, auto.boundaryClearanceSections
+        );
         data.canvas$lastSplitResult = split ? "completed" : "rejected or failed (see console)";
+        if (!split) {
+            LOGGER.warn("Canvas auto-split rejected region {} ({} sections, {} players, {} entities, {}ms): "
+                    + "no safe split boundary or layout",
+                region.getId(), region.regioniser.getSectionCount(region), players, entities, Math.round(mspt));
+        }
     }
 
