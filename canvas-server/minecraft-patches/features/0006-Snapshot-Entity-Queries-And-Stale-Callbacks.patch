     protected ChunkEntitySlices moveEntity(final Entity entity) {
+        // Canvas - if the entity is no longer owned by this thread after a dynamic region split,
+        // defer the move to the region that currently owns the entity's block position.
+        if (!ca.spottedleaf.moonrise.common.util.TickThread.isTickThreadFor(entity)) {
+            final net.minecraft.world.entity.Entity fEntity = entity;
+            final net.minecraft.core.BlockPos p = fEntity.blockPosition();
+            io.papermc.paper.threadedregions.RegionizedServer.getInstance().taskQueue.queueTickTaskQueue(
+                (net.minecraft.server.level.ServerLevel) fEntity.level(), p.getX() >> 4, p.getZ() >> 4,
+                () -> this.moveEntity(fEntity));
+            return null;
+        }
         // ensure we own the entity
         this.checkThread(entity, "Cannot move entity off-main");
 
@@ -547,8 +563,59 @@ public abstract class EntityLookup implements LevelEntityGetter<Entity> {
             return null;
         }
 
-        // ensure the new section is owned by this tick thread
-        this.checkThread(newSectionX, newSectionZ, "Cannot move entity off-main");
+        // Canvas - perform a real cross-region handoff. Removing on this thread
+        // and re-adding on the destination thread keeps Moonrise slices and
+        // RegionizedWorldData membership consistent with chunk ownership.
+        if (!ca.spottedleaf.moonrise.common.util.TickThread.isTickThreadFor(this.world, newSectionX, newSectionZ)) {
+            final Entity transferring = entity;
+            if (!this.canRemoveEntity(transferring)) return null;
+            final UUID transferId = transferring.getUUID();
+            if (CANVAS_REGION_TRANSFERS.putIfAbsent(transferId, Boolean.TRUE) != null) return null;
+            try {
+                final net.minecraft.server.level.ServerLevel level = (net.minecraft.server.level.ServerLevel)this.world;
+                final io.papermc.paper.threadedregions.RegionizedWorldData source = level.getCurrentWorldData();
+                final net.minecraft.server.level.ServerPlayer player = transferring instanceof net.minecraft.server.level.ServerPlayer sp ? sp : null;
+                if (player != null && source != null) source.removeConnection(player);
+
+                // CHANGED_DIMENSION removes without destroying or retiring the
+                // scheduler, matching the existing dimension-transfer lifecycle.
+                transferring.setRemoved(Entity.RemovalReason.CHANGED_DIMENSION, null);
+                io.papermc.paper.threadedregions.RegionizedServer.getInstance().taskQueue.queueTickTaskQueue(
+                    level, newSectionX, newSectionZ, () -> {
+                        try {
+                            if (transferring.isRemoved()) transferring.unsetRemoved();
+                            if (!EntityLookup.this.addEntity(transferring, false, false)) {
+                                LOGGER.error("Failed to complete cross-region entity handoff for {}", transferring);
+                                transferring.setRemoved(Entity.RemovalReason.DISCARDED, null);
+                                return;
+                            }
+                            if (player != null) {
+                                final io.papermc.paper.threadedregions.RegionizedWorldData target = level.getCurrentWorldData();
+                                if (target != null) target.addConnection(player);
+                            }
+                        } finally {
+                            CANVAS_REGION_TRANSFERS.remove(transferId);
+                        }
+                    });
+            } catch (final Throwable thrown) {
+                CANVAS_REGION_TRANSFERS.remove(transferId);
+                throw thrown;
+            }
+            return null;
+        }
+
+        // Canvas start - stale entity callback after a live split
+        // A callback queued before a split can replay after the entity was
+        // removed and re-added by the destination region. The cached old
+        // section is then stale (or never initialised), and this thread does
+        // not own it. The destination region owns the entity now, so there is
+        // nothing to move here; returning also avoids the
+        // "Cannot move entity off-main" halt on chunk -2147483648.
+        if (sectionX == Integer.MIN_VALUE || sectionZ == Integer.MIN_VALUE
+            || !ca.spottedleaf.moonrise.common.util.TickThread.isTickThreadFor(this.world, sectionX, sectionZ)) {
+            return null;
+        }
+        // Canvas end - stale entity callback after a live split
 
         // ensure the old section is owned by this tick thread
         this.checkThread(sectionX, sectionZ, "Cannot move entity off-main");
