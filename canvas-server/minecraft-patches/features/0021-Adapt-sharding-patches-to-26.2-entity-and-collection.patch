diff --git a/net/minecraft/server/level/ServerLevel.java b/net/minecraft/server/level/ServerLevel.java
index 89587c791bedb5b36d5b09cdde5411e40cfd57a2..26198343e4892860c2b3d14d12b03bdb4dbba949 100644
--- a/net/minecraft/server/level/ServerLevel.java
+++ b/net/minecraft/server/level/ServerLevel.java
@@ -1573,7 +1573,11 @@ public class ServerLevel extends Level implements WorldGenLevel, ServerEntityGet
         if (entity instanceof Player) {
             throw new IllegalStateException("Players must use tickNonPassenger");
         }
-        entity.commonTick();
+        // Canvas 26.2 - Entity.commonTick() does not exist yet; its work is
+        // inlined in the serial tickNonPassenger path in this version.
+        entity.setOldPosAndRot();
+        entity.tickCount++;
+        entity.totalEntityAge++; // Paper - age-like counter for all entities
         final boolean isActive = io.papermc.paper.entity.activation.ActivationRange.checkIfActive(entity);
         if (isActive) {
             entity.tick();
