+    public boolean splitRegionLive(final @NonNull ThreadedRegion<R, S> region, final int requestedShards) {
+        return this.splitRegion(region, requestedShards, false, java.util.Set.of(), 0);
+    }
+
+    public boolean splitRegionLive(final @NonNull ThreadedRegion<R, S> region, final int requestedShards,
+                                   final java.util.Set<Long> playerSections, final int boundaryClearanceSections) {
+        return this.splitRegion(region, requestedShards, false, playerSections, boundaryClearanceSections);
+    }
+
+    private boolean splitRegion(final @NonNull ThreadedRegion<R, S> region, final int requestedShards, final boolean idle,
+                                final java.util.Set<Long> playerSections, final int boundaryClearanceSections) {
+        this.acquireWriteLock();
+        boolean committed = false;
+        try {
+            if ((idle ? region.state != ThreadedRegion.STATE_READY : region.state != ThreadedRegion.STATE_TICKING)
+                || region.sectionByKey.size() < 2) return false;
+            if (!region.mergeIntoLater.isEmpty() || !region.expectingMergeFrom.isEmpty()) return false;
+
+            final java.util.List<ThreadedRegionSection<R, S>> allSections =
+                new java.util.ArrayList<>(region.sectionByKey.values());
+            final java.util.List<java.util.List<ThreadedRegionSection<R, S>>> groups =
+                this.buildLiveSplitGroups(region, requestedShards, playerSections, boundaryClearanceSections);
+            if (groups.size() < 2) {
+                LOGGER.warn("Canvas live split rejected for region {}: no safe boundary with {} player sections, clearance {}",
+                    region.getId(), playerSections.size(), boundaryClearanceSections);
+                return false;
+            }
+
+            final java.util.List<ThreadedRegion<R, S>> newRegionObjects = new ArrayList<>(groups.size());
+            for (int i = 0; i < groups.size(); i++) newRegionObjects.add(new ThreadedRegion<>(this));
+
+            this.callbacks.preSplit(region, newRegionObjects);
+            region.getData().prepareForLiveSplit(newRegionObjects);
+
+            // Commit point: after this line failure is unrecoverable and must
+            // stop the server instead of continuing with partial ownership.
+            committed = true;
+            region.state = ThreadedRegion.STATE_DEAD;
+            // Always deschedule the old handle, even for an idle manual split.
+            region.onRemove(true);
+
+            final Long2ReferenceOpenHashMap<ThreadedRegion<R, S>> newRegionsMap = new Long2ReferenceOpenHashMap<>();
+            final ReferenceOpenHashSet<ThreadedRegion<R, S>> newRegionsSet = new ReferenceOpenHashSet<>(newRegionObjects);
+
+            for (int i = 0; i < groups.size(); i++) {
+                final ThreadedRegion<R, S> newRegion = newRegionObjects.get(i);
+                for (final ThreadedRegionSection<R, S> section : groups.get(i)) {
+                    // Replace the owner directly; never publish a null gap to
+                    // lock-free getRegionAtUnsynchronised readers.
+                    newRegion.addSection(section, region);
+                    newRegionsMap.put(section.sectionKey, newRegion);
+                }
+            }
+
+            region.split(newRegionsMap, newRegionsSet);
+            region.getData().clearForLiveSplit();
+            LOGGER.warn("Canvas live split complete: {} sections -> {} regions at {}",
+                allSections.size(), newRegionsSet.size(), System.currentTimeMillis());
+
+            for (final ThreadedRegion<R, S> newRegion : newRegionsSet) {
+                newRegion.state = ThreadedRegion.STATE_READY;
+                newRegion.onCreate();
+                this.callbacks.onRegionActive(newRegion);
+            }
+            return true;
+        } catch (final Throwable thrown) {
+            if (committed) {
+                LOGGER.error("Live split committed but failed for region {}; halting to avoid corrupted ownership", region, thrown);
+                SneakyThrow.sneaky(thrown);
+            }
+            LOGGER.error("Failed live split of region {}", region, thrown);
+            return false;
+        } finally {
+            this.releaseWriteLock();
+        }
+    }
