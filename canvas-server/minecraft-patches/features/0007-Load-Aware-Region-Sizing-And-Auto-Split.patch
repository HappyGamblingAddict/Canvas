+    // Canvas - manual requests are only accepted for ticking regions and are
+    // consumed at end-of-tick. Validation and flag publication share one lock.
+    public boolean requestLiveSplit(final @NonNull ThreadedRegion<R, S> region) {
+        this.acquireWriteLock();
+        try {
+            if (region.regioniser != this || region.state != ThreadedRegion.STATE_TICKING
+                || region.sectionByKey.size() < 2
+                || !region.mergeIntoLater.isEmpty() || !region.expectingMergeFrom.isEmpty()) return false;
+            region.getData().requestLiveSplit();
+            return true;
+        } finally {
+            this.releaseWriteLock();
+        }
+    }
