+    // Canvas - inclusive section bounds used by the experimental shard layout.
+    public int[] getSectionBounds(final @NonNull ThreadedRegion<R, S> region) {
+        this.acquireWriteLock();
+        try {
+            int minX = Integer.MAX_VALUE, minZ = Integer.MAX_VALUE;
+            int maxX = Integer.MIN_VALUE, maxZ = Integer.MIN_VALUE;
+            for (final ThreadedRegionSection<R, S> section : region.sectionByKey.values()) {
+                minX = Math.min(minX, section.sectionX); maxX = Math.max(maxX, section.sectionX);
+                minZ = Math.min(minZ, section.sectionZ); maxZ = Math.max(maxZ, section.sectionZ);
+            }
+            return new int[] { minX, minZ, maxX, maxZ };
+        } finally {
+            this.releaseWriteLock();
+        }
+    }
