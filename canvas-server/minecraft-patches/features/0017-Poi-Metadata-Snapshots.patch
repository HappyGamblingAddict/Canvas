     public boolean release(final BlockPos pos) {
+        io.canvasmc.canvas.threadedregions.sharding.RegionShardExecutor.ensureSerialPoiAccess("PoiManager.release");
         return this.getOrLoad(SectionPos.asLong(pos))
             .map(section -> section.release(pos))
             .orElseThrow(() -> Util.pauseInIde(new IllegalStateException("POI never registered at " + pos)));
     }
 
     public boolean exists(final BlockPos pos, final Predicate<Holder<PoiType>> predicate) {
+        if (this.outsideStoredRange(SectionPos.asLong(pos))) return false;
+        if (io.canvasmc.canvas.threadedregions.sharding.RegionShardExecutor.canQueryPois(this.world)) {
+            final io.canvasmc.canvas.threadedregions.sharding.RegionShardSnapshot.PoiEntry entry =
+                io.canvasmc.canvas.threadedregions.sharding.RegionShardExecutor.canvas$getPoiSnapshot(this.world, pos);
+            return entry != null && predicate.test(entry.type());
+        }
+        io.canvasmc.canvas.threadedregions.sharding.RegionShardExecutor.ensureSerialPoiAccess("PoiManager.exists");
         return this.getOrLoad(SectionPos.asLong(pos)).map(s -> s.exists(pos, predicate)).orElse(false);
     }
 
     public Optional<Holder<PoiType>> getType(final BlockPos pos) {
+        if (this.outsideStoredRange(SectionPos.asLong(pos))) return Optional.empty();
+        if (io.canvasmc.canvas.threadedregions.sharding.RegionShardExecutor.canQueryPois(this.world)) {
+            final io.canvasmc.canvas.threadedregions.sharding.RegionShardSnapshot.PoiEntry entry =
+                io.canvasmc.canvas.threadedregions.sharding.RegionShardExecutor.canvas$getPoiSnapshot(this.world, pos);
+            return entry == null ? Optional.empty() : Optional.of(entry.type());
+        }
+        io.canvasmc.canvas.threadedregions.sharding.RegionShardExecutor.ensureSerialPoiAccess("PoiManager.getType");
         return this.getOrLoad(SectionPos.asLong(pos)).flatMap(section -> section.getType(pos));
     }
 
