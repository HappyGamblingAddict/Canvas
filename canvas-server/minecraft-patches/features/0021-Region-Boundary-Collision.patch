From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: LinuxAddict <super2niia39@gmail.com>
Date: Sat, 28 Nov 2026 00:00:00 +0000
Subject: [PATCH] Fix invisible collision wall at region boundaries


diff --git a/ca/spottedleaf/moonrise/patches/collisions/CollisionUtil.java b/ca/spottedleaf/moonrise/patches/collisions/CollisionUtil.java
index 82b442b..046fa25 100644
--- a/ca/spottedleaf/moonrise/patches/collisions/CollisionUtil.java
+++ b/ca/spottedleaf/moonrise/patches/collisions/CollisionUtil.java
@@ -1938,7 +1938,14 @@ public final class CollisionUtil {
         final boolean loadChunks = (collisionFlags & COLLISION_FLAG_LOAD_CHUNKS) != 0;
         final ChunkSource chunkSource = world.getChunkSource();
         // Canvas start - region threading
-        final int chunkRad = 4;
+        // Ownership is per section: the ticking region owns every chunk in its
+        // sections, and EntityLookup uses the same section-level check when it
+        // hands an entity off to the destination region. The previous 4-chunk
+        // halo was a much stronger condition: near a region boundary it failed
+        // even for chunks this region really owns, especially with a small
+        // max-region-sections cap or after a live split. A zero radius keeps
+        // the exact ownership boundary without the false negatives.
+        final int chunkRad = 0;
         final boolean ownsEveryChunk = ca.spottedleaf.moonrise.common.util.TickThread.isTickThreadFor(
             world, minChunkX, minChunkZ, maxChunkX, maxChunkZ, chunkRad
         );
@@ -1956,13 +1963,21 @@ public final class CollisionUtil {
                     ownsEveryChunk
                     || (!searchingOneChunk && ca.spottedleaf.moonrise.common.util.TickThread.isTickThreadFor(world, currChunkX, currChunkZ, chunkRad));
                 if (!ownsChunk) {
-                    if (checkOnly) {
-                        return true;
-                    } else {
-                        intoAABB.add(getBoxForChunk(currChunkX, currChunkZ));
-                        ret = true;
-                        continue;
-                    }
+                    // Canvas start - region boundary collisions
+                    // Another region owns this chunk, so reading its block
+                    // states here would race with that region's tick thread.
+                    // Skipping it is the safe alternative to the old solid
+                    // chunk box: that box stopped every entity at the boundary
+                    // before the cross-region handoff could run.
+                    //
+                    // Tradeoff: block collisions inside the neighbouring
+                    // section are ignored for the brief window before the
+                    // entity is transferred, and checkOnly reports "free".
+                    // The destination region resumes normal collision checks
+                    // on its first tick. The world border check above is
+                    // deliberately unchanged.
+                    continue;
+                    // Canvas end - region boundary collisions
                 }
                 // Folia & Canvas end - region threading
                 final ChunkAccess chunk = chunkSource.getChunk(currChunkX, currChunkZ, ChunkStatus.FULL, loadChunks);
