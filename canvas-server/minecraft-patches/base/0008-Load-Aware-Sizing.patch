+    // Canvas - section count helper for load-aware live splitting
+    public int getSectionCount(final @NonNull ThreadedRegion<R, S> region) { return region.sectionByKey.size(); }
+
+    public record LiveSplitPreview(boolean eligible, String reason, int sections, int chunks,
+                                   int players, int entities, int shards, boolean immediate) {}
+
+    // Canvas - inspect a live split without modifying region state. The write lock
+    // makes the snapshot consistent with add/remove chunk operations.
+    public LiveSplitPreview previewLiveSplit(final @NonNull ThreadedRegion<R, S> region) {
+        this.acquireWriteLock();
+        try {
+            final int sections = region.sectionByKey.size();
+            int chunks = 0;
+            for (final ThreadedRegionSection<R, S> section : region.sectionByKey.values()) {
+                chunks += section.chunkCount;
+            }
+            final boolean immediate = region.state == ThreadedRegion.STATE_READY;
+            if (region.state != ThreadedRegion.STATE_TICKING && !immediate) {
+                return new LiveSplitPreview(false, "region is transient or dead", sections, chunks,
+                    region.getData().getRegionPlayerCount(), region.getData().getRegionEntityCount(), 1, false);
+            }
+            if (!region.mergeIntoLater.isEmpty() || !region.expectingMergeFrom.isEmpty()) {
+                return new LiveSplitPreview(false, "region is currently merging", sections, chunks,
+                    region.getData().getRegionPlayerCount(), region.getData().getRegionEntityCount(), 1, false);
+            }
+            if (sections < 2) {
+                return new LiveSplitPreview(false, "region has fewer than two sections", sections, chunks,
+                    region.getData().getRegionPlayerCount(), region.getData().getRegionEntityCount(), 1, false);
+            }
+            final int requested = io.papermc.paper.configuration.GlobalConfiguration.get().threadedRegions.liveSplitShards;
+            final java.util.List<java.util.List<ThreadedRegionSection<R, S>>> groups = this.buildLiveSplitGroups(region, requested);
+            if (groups.size() < 2) {
+                return new LiveSplitPreview(false, "region is too small for the configured minimum shard size", sections, chunks,
+                    region.getData().getRegionPlayerCount(), region.getData().getRegionEntityCount(), 1, false);
+            }
+            return new LiveSplitPreview(true, immediate ? "ready (idle, immediate)" : "ready (end-of-tick)", sections, chunks,
+                region.getData().getRegionPlayerCount(), region.getData().getRegionEntityCount(), groups.size(), immediate);
+        } finally {
+            this.releaseWriteLock();
+        }
+    }
+
+    // Canvas - idle regions can split immediately under the write lock. Ticking
+    // regions queue a request that TickRegions consumes at end-of-tick.
+    public boolean requestLiveSplit(final @NonNull ThreadedRegion<R, S> region) {
+        final LiveSplitPreview preview = this.previewLiveSplit(region);
+        if (!preview.eligible()) return false;
+        if (preview.immediate()) {
+            return this.splitRegion(region,
+                io.papermc.paper.configuration.GlobalConfiguration.get().threadedRegions.liveSplitShards, true);
+        }
+        region.getData().requestLiveSplit();
+        return true;
+    }
+
+    // Canvas - recursively split the heaviest spatial group along its longer
+    // axis. Unlike a fixed grid this never creates empty shards, and balancing by
+    // chunk count keeps a sparse tail from becoming its own overloaded region.
+    private java.util.List<java.util.List<ThreadedRegionSection<R, S>>> buildLiveSplitGroups(
+        final @NonNull ThreadedRegion<R, S> region, final int requestedShards) {
+        final int target = Math.max(2, Math.min(8, requestedShards));
+        final int minSections = Math.max(1,
+            io.papermc.paper.configuration.GlobalConfiguration.get().threadedRegions.liveSplitMinSectionsPerShard);
+        final java.util.List<java.util.List<ThreadedRegionSection<R, S>>> groups = new java.util.ArrayList<>();
+        groups.add(new java.util.ArrayList<>(region.sectionByKey.values()));
+
+        while (groups.size() < target) {
+            int best = -1;
+            long bestLoad = -1L;
+            for (int i = 0; i < groups.size(); i++) {
+                final java.util.List<ThreadedRegionSection<R, S>> group = groups.get(i);
+                int nonEmpty = 0;
+                long load = 0L;
+                for (final ThreadedRegionSection<R, S> section : group) {
+                    if (!section.isEmpty()) nonEmpty++;
+                    load += section.chunkCount;
+                }
+                if (group.size() >= minSections * 2 && nonEmpty >= 2 && load > bestLoad) {
+                    best = i;
+                    bestLoad = load;
+                }
+            }
+            if (best < 0) break;
+            final java.util.List<ThreadedRegionSection<R, S>> right = this.splitLiveGroup(groups.get(best), minSections);
+            if (right == null) break;
+            groups.add(right);
+        }
+        return groups;
+    }
+
+    private java.util.List<ThreadedRegionSection<R, S>> splitLiveGroup(final java.util.List<ThreadedRegionSection<R, S>> group, final int minSections) {
+        int minX = Integer.MAX_VALUE, maxX = Integer.MIN_VALUE;
+        int minZ = Integer.MAX_VALUE, maxZ = Integer.MIN_VALUE;
+        long totalChunks = 0L;
+        for (final ThreadedRegionSection<R, S> section : group) {
+            minX = Math.min(minX, section.sectionX);
+            maxX = Math.max(maxX, section.sectionX);
+            minZ = Math.min(minZ, section.sectionZ);
+            maxZ = Math.max(maxZ, section.sectionZ);
+            totalChunks += section.chunkCount;
+        }
+        final boolean byX = (maxX - minX) >= (maxZ - minZ);
+        group.sort(java.util.Comparator
+            .comparingInt((ThreadedRegionSection<R, S> section) -> byX ? section.sectionX : section.sectionZ)
+            .thenComparingInt(section -> byX ? section.sectionZ : section.sectionX));
+
+        final int[] prefixChunks = new int[group.size() + 1];
+        final int[] prefixNonEmpty = new int[group.size() + 1];
+        for (int i = 0; i < group.size(); i++) {
+            final ThreadedRegionSection<R, S> section = group.get(i);
+            prefixChunks[i + 1] = prefixChunks[i] + section.chunkCount;
+            prefixNonEmpty[i + 1] = prefixNonEmpty[i] + (section.isEmpty() ? 0 : 1);
+        }
+
+        int bestCut = -1;
+        long bestImbalance = Long.MAX_VALUE;
+        for (int cut = minSections; cut <= group.size() - minSections; cut++) {
+            if (prefixNonEmpty[cut] == 0 || prefixNonEmpty[group.size()] - prefixNonEmpty[cut] == 0) continue;
+            final long imbalance = Math.abs(totalChunks - 2L * prefixChunks[cut]);
+            if (imbalance < bestImbalance) {
+                bestImbalance = imbalance;
+                bestCut = cut;
+            }
+        }
+        if (bestCut < 0) return null;
+
+        final java.util.List<ThreadedRegionSection<R, S>> right = new java.util.ArrayList<>(group.subList(bestCut, group.size()));
+        group.subList(bestCut, group.size()).clear();
+        return right;
+    }
