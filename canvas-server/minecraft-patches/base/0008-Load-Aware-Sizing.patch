+    // Canvas - after a live split the old region is dead, but its tick handle may
+    // still be finishing the current tick. Drop its stale collections so nothing
+    // is ticked twice or under the wrong region thread.
+    public void clearAfterLiveSplit() {
+        this.allEntities.clear();
+        this.loadedEntities.clear();
+        for (final Iterator<Entity> canvasIt = this.entityTickList.unsafeIterator(); canvasIt.hasNext();) {
+            canvasIt.next(); canvasIt.remove();
+        }
+        for (final Iterator<Mob> canvasIt = this.navigatingMobs.unsafeIterator(); canvasIt.hasNext();) {
+            canvasIt.next(); canvasIt.remove();
+        }
+        this.trackerEntities.clear();
+        this.entityTickingChunks.clear();
+        this.tickingChunks.clear();
+        this.chunks.clear();
+        this.pendingBlockEntityTickers.clear();
+        this.blockEntityTickers.clear();
+        this.blockEvents.clear();
+        this.chunkHoldersToBroadcast.clear();
+        this.connections.clear();
+        this.localPlayers.clear();
+    }
