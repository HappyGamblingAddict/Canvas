diff --git a/ca/spottedleaf/moonrise/patches/chunk_system/level/entity/EntityLookup.java b/ca/spottedleaf/moonrise/patches/chunk_system/level/entity/EntityLookup.java
--- a/ca/spottedleaf/moonrise/patches/chunk_system/level/entity/EntityLookup.java
+++ b/ca/spottedleaf/moonrise/patches/chunk_system/level/entity/EntityLookup.java
@@ -633,6 +633,10 @@ public abstract class EntityLookup implements LevelEntityGetter<Entity> {
     }
 
     public void getEntities(final Entity except, final AABB box, final List<Entity> into, final Predicate<? super Entity> predicate) {
+        if (io.canvasmc.canvas.threadedregions.sharding.RegionShardExecutor.queryEntities(
+            this.world, except, box, predicate, into, Integer.MAX_VALUE)) return;
+        if (io.canvasmc.canvas.threadedregions.sharding.RegionShardExecutor.queryEntities(
+            this.world, except, box, predicate, into, Integer.MAX_VALUE)) return;
         final int minChunkX = (Mth.floor(box.minX) - 2) >> 4;
         final int minChunkZ = (Mth.floor(box.minZ) - 2) >> 4;
         final int maxChunkX = (Mth.floor(box.maxX) + 2) >> 4;
@@ -712,6 +716,14 @@ public abstract class EntityLookup implements LevelEntityGetter<Entity> {
 
     public <T extends Entity> void getEntities(final EntityType<?> type, final AABB box, final List<? super T> into,
                                                final Predicate<? super T> predicate) {
+        if (io.canvasmc.canvas.threadedregions.sharding.RegionShardExecutor.queryEntities(
+            this.world, null, box,
+            entity -> entity.getType() == type && (predicate == null || predicate.test((T)entity)),
+            into, Integer.MAX_VALUE)) return;
+        if (io.canvasmc.canvas.threadedregions.sharding.RegionShardExecutor.queryEntities(
+            this.world, null, box,
+            entity -> entity.getType() == type && (predicate == null || predicate.test((T)entity)),
+            into, Integer.MAX_VALUE)) return;
         final int minChunkX = (Mth.floor(box.minX) - 2) >> 4;
         final int minChunkZ = (Mth.floor(box.minZ) - 2) >> 4;
         final int maxChunkX = (Mth.floor(box.maxX) + 2) >> 4;
@@ -752,6 +764,14 @@ public abstract class EntityLookup implements LevelEntityGetter<Entity> {
 
     public <T extends Entity> void getEntities(final Class<? extends T> clazz, final Entity except, final AABB box, final List<? super T> into,
                                                final Predicate<? super T> predicate) {
+        if (io.canvasmc.canvas.threadedregions.sharding.RegionShardExecutor.queryEntities(
+            this.world, except, box,
+            entity -> clazz.isInstance(entity) && (predicate == null || predicate.test((T)entity)),
+            into, Integer.MAX_VALUE)) return;
+        if (io.canvasmc.canvas.threadedregions.sharding.RegionShardExecutor.queryEntities(
+            this.world, except, box,
+            entity -> clazz.isInstance(entity) && (predicate == null || predicate.test((T)entity)),
+            into, Integer.MAX_VALUE)) return;
         final int minChunkX = (Mth.floor(box.minX) - 2) >> 4;
         final int minChunkZ = (Mth.floor(box.minZ) - 2) >> 4;
         final int maxChunkX = (Mth.floor(box.maxX) + 2) >> 4;
@@ -794,6 +814,10 @@ public abstract class EntityLookup implements LevelEntityGetter<Entity> {
 
     public void getEntities(final Entity except, final AABB box, final List<Entity> into, final Predicate<? super Entity> predicate,
                             final int maxCount) {
+        if (io.canvasmc.canvas.threadedregions.sharding.RegionShardExecutor.queryEntities(
+            this.world, except, box, predicate, into, maxCount)) return;
+        if (io.canvasmc.canvas.threadedregions.sharding.RegionShardExecutor.queryEntities(
+            this.world, except, box, predicate, into, maxCount)) return;
         final int minChunkX = (Mth.floor(box.minX) - 2) >> 4;
         final int minChunkZ = (Mth.floor(box.minZ) - 2) >> 4;
         final int maxChunkX = (Mth.floor(box.maxX) + 2) >> 4;
